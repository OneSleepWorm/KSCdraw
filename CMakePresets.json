{
  "version": 3,
  "configurePresets": [
    {
      "name": "PC Debug",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build_debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "PC Release",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build_release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "Linux-Debug",
      "displayName": "Linux Native Debug (SDL2)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-debug",
      "cacheVariables": {
        "LINUX_NATIVE": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Linux-Release",
      "displayName": "Linux Native Release (SDL2)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "LINUX_NATIVE": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "Firmware-Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/Debug",
      "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
      "cacheVariables": {
        "STM32_FIRMWARE": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Firmware-Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/Release",
      "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
      "cacheVariables": {
        "STM32_FIRMWARE": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "Linux-Debug", "configurePreset": "Linux-Debug" },
    { "name": "Linux-Release", "configurePreset": "Linux-Release" },
    { "name": "Firmware-Debug", "configurePreset": "Firmware-Debug" },
    { "name": "Firmware-Release", "configurePreset": "Firmware-Release" }
  ]
}